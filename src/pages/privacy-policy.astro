---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import data from '../content/pages/privacy-policy.json';
---

<Layout 
  title="Privacy Policy | Actors Theatre Rajasthan" 
  description="Privacy Policy for Actors Theatre Rajasthan (ATR)."
>
  <Navbar />
  
  <main class="page-container">
    <div class="container">
      <div class="page-header">
        <h1 class="page-title">Privacy Policy</h1>
        <div class="gold-divider"></div>
      </div>
      
      <div class="policy-content">
        <p><strong>Effective Date:</strong> {data.effectiveDate}</p>

        {data.sections.map((section) => (
          <>
            <h2>{section.title}</h2>
            <p>{section.content}</p>
            {section.list && section.list.length > 0 && (
              <ul>
                {section.list.map((item) => (
                  <li set:html={item}></li>
                ))}
              </ul>
            )}
          </>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .page-container {
    padding-top: var(--nav-height);
    padding-bottom: 5rem;
    min-height: calc(100vh - 400px);
    background-color: var(--white);
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .page-header {
    margin-top: 4rem;
    margin-bottom: 3rem;
  }

  .page-title {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    color: var(--text-dark);
    margin-bottom: 1.5rem;
    font-family: 'Playfair Display', serif;
  }

  .policy-content {
    color: var(--text-muted);
    line-height: 1.8;
    font-size: 1.1rem;
  }

  .policy-content h2 {
    color: var(--primary);
    font-size: 1.75rem;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-family: 'Playfair Display', serif;
  }

  .policy-content p {
    margin-bottom: 1rem;
  }

  .policy-content ul {
    list-style-type: disc;
    margin-left: 2rem;
    margin-bottom: 1.5rem;
  }
  
  .policy-content li {
    margin-bottom: 0.5rem;
  }
</style>
