---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

import data from '../content/pages/activities.json';
const activities = data.activities;
---

<Layout 
  title="Our Activities & Archives | Actors Theatre Rajasthan" 
  description="Chronological record of theatre activities, workshops, festivals and stage productions conducted by Actors Theatre Rajasthan from 2023 to 2026."
>
  <Navbar />

  <main class="activities-page">
    <div class="container">
      <div class="activities-hero">
        <a href="/" class="back-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
            <line x1="19" y1="12" x2="5" y2="12"/>
            <polyline points="12 19 5 12 12 5"/>
          </svg>
          <span>Back to Home</span>
        </a>
        
        <span class="section-label">Official Archives</span>
        <h1 class="activities-title">Theatre Activities</h1>
        <div class="gold-divider"></div>
        <p class="activities-subtitle">
          The exact chronological record of stage productions, children's theatre training camps, 
          social awareness street campaigns, and national festivals organised between 2023 and 2026.
        </p>
      </div>

      <!-- Linear Document-Style Layout -->
      <div class="activities-list">
        {[...activities].reverse().map((act) => (
          <div class="activity-entry">
            <div class="activity-bullet"></div>
            <div class="activity-content">
              <p class="activity-text">{act.text}</p>
              {act.images && act.images.length > 0 && (
                <div class="activity-photo-row">
                  {act.images.map((img: string) => (
                    <div class="activity-photo-wrapper">
                      <img src={img} alt="Activity documentation" class="gallery-trigger" loading="lazy" />
                    </div>
                  ))}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </main>

  <!-- Image Lightbox Modal -->
  <div class="lightbox" id="lightbox">
    <button class="lightbox-close" id="lightbox-close" aria-label="Close image">×</button>
    <button class="lightbox-nav prev" id="lightbox-prev" aria-label="Previous image">‹</button>
    <img class="lightbox-content" id="lightbox-img" alt="Enlarged gallery photo" />
    <button class="lightbox-nav next" id="lightbox-next" aria-label="Next image">›</button>
  </div>

  <Footer />
</Layout>

<style>
  .activities-page {
    padding-top: 8rem;
    padding-bottom: 6rem;
    background: var(--bg-body);
  }

  .activities-hero {
    max-width: 700px;
    margin-bottom: 4rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--saffron);
    margin-bottom: 2rem;
    transition: var(--transition);
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--saffron-deep);
    transform: translateX(-4px);
  }

  .activities-title {
    font-size: clamp(2.5rem, 5vw, 3.8rem);
    color: var(--ink);
    line-height: 1.1;
    margin-top: 0.5rem;
  }

  .activities-hero .gold-divider {
    margin: 1.5rem 0;
  }

  .activities-subtitle {
    font-size: 1.05rem;
    color: var(--ink-body);
    line-height: 1.85;
  }

  /* Document list layout */
  .activities-list {
    display: flex;
    flex-direction: column;
    gap: 4rem;
    margin-top: 2rem;
  }

  .activity-entry {
    display: flex;
    gap: 3rem;
    padding-bottom: 4rem;
    border-bottom: 1px solid var(--border);
    align-items: flex-start;
  }

  .activity-entry:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .activity-bullet {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--saffron);
    margin-top: 0.5rem;
    flex-shrink: 0;
    box-shadow: 0 0 0 4px rgba(255, 153, 51, 0.2);
  }

  .activity-content {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .activity-text {
    font-size: 1.1rem;
    color: var(--ink-body);
    line-height: 1.85;
    font-family: 'Inter', sans-serif;
    max-width: 850px;
  }

  /* Photos layout */
  .activity-photo-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 0.5rem;
  }

  .activity-photo-wrapper {
    position: relative;
    width: calc(33.333% - 0.85rem);
    min-width: 250px;
    max-width: 280px;
    aspect-ratio: 4/3;
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
    cursor: zoom-in;
    background: #000000;
  }

  .activity-photo-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .activity-photo-wrapper:hover img {
    transform: scale(1.05);
  }

  /* Lightbox Styles */
  .lightbox {
    position: fixed;
    inset: 0;
    background: rgba(26, 24, 22, 0.96);
    z-index: 1000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .lightbox.active {
    display: flex;
  }

  .lightbox-content {
    max-width: 90%;
    max-height: 80vh;
    object-fit: contain;
    border-radius: 4px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
  }

  .lightbox-close {
    position: absolute;
    top: 2rem;
    right: 2rem;
    background: none;
    border: none;
    color: #FFFFFF;
    font-size: 3rem;
    cursor: pointer;
    line-height: 0.5;
    opacity: 0.7;
    transition: opacity 0.2s ease;
  }

  .lightbox-close:hover {
    opacity: 1;
  }

  .lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(0, 0, 0, 0.4);
    border: none;
    color: #FFFFFF;
    font-size: 3.5rem;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.6;
    transition: opacity 0.2s ease, background-color 0.2s ease;
  }

  .lightbox-nav:hover {
    opacity: 1;
    background: rgba(0, 0, 0, 0.7);
  }

  .lightbox-nav.prev { left: 2rem; }
  .lightbox-nav.next { right: 2rem; }

  @media (max-width: 768px) {
    .activity-entry {
      flex-direction: column;
      gap: 1rem;
      padding-bottom: 3rem;
    }
    
    .activity-bullet {
      margin-left: 0.5rem;
    }

    .activity-photo-wrapper {
      width: 100%;
      max-width: 100%;
    }

    .lightbox-nav {
      width: 44px;
      height: 44px;
      font-size: 2.5rem;
    }
  }
</style>

<script>
  // Lightbox functionality
  const triggers = document.querySelectorAll('.gallery-trigger');
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const closeBtn = document.getElementById('lightbox-close');
  const prevBtn = document.getElementById('lightbox-prev');
  const nextBtn = document.getElementById('lightbox-next');

  let currentImagesList: string[] = [];
  let currentIndex = 0;

  // Gather all unique image paths currently displayed on the page
  function updateImagesList() {
    currentImagesList = [];
    const visibleTriggers = document.querySelectorAll('.gallery-trigger');
    visibleTriggers.forEach(img => {
      const src = img.getAttribute('src');
      if (src && !currentImagesList.includes(src)) {
        currentImagesList.push(src);
      }
    });
  }

  triggers.forEach(trigger => {
    trigger.addEventListener('click', (e) => {
      const target = e.target as HTMLImageElement;
      updateImagesList();
      const currentSrc = target.getAttribute('src');
      if (currentSrc) {
        currentIndex = currentImagesList.indexOf(currentSrc);
        openLightbox();
      }
    });
  });

  function openLightbox() {
    if (lightboxImg && currentImagesList[currentIndex]) {
      lightboxImg.src = currentImagesList[currentIndex];
      lightbox?.classList.add('active');
      document.body.style.overflow = 'hidden'; // Prevent background scrolling
    }
  }

  function closeLightbox() {
    lightbox?.classList.remove('active');
    document.body.style.overflow = '';
  }

  closeBtn?.addEventListener('click', closeLightbox);

  prevBtn?.addEventListener('click', () => {
    currentIndex = (currentIndex - 1 + currentImagesList.length) % currentImagesList.length;
    if (lightboxImg) lightboxImg.src = currentImagesList[currentIndex];
  });

  nextBtn?.addEventListener('click', () => {
    currentIndex = (currentIndex + 1) % currentImagesList.length;
    if (lightboxImg) lightboxImg.src = currentImagesList[currentIndex];
  });

  // Close when clicking outside of image
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) {
      closeLightbox();
    }
  });

  // Keyboard navigation
  document.addEventListener('keydown', (e) => {
    if (!lightbox?.classList.contains('active')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') prevBtn?.click();
    if (e.key === 'ArrowRight') nextBtn?.click();
  });
</script>
