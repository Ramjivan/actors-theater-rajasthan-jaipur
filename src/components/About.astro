---
import data from '../../content/home/about.json';
---

<section class="about section" id="about">
  <div class="container">
    <div class="about-grid">
      <div class="about-content animate-in">
        <span class="section-label">{data.label}</span>
        <h2 class="section-title" set:html={data.title}></h2>
        <div class="gold-divider"></div>
        {data.paragraphs.map(p => (
          <p class="about-text" set:html={p}></p>
        ))}

        <div class="about-pillars">
          {data.pillars.map(pillar => (
            <div class="pillar">
              <div class="pillar-icon" set:html={pillar.iconHtml}></div>
              <div>
                <h4>{pillar.title}</h4>
                <p>{pillar.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="about-visual animate-in">
        <div class="image-stack">
          <div class="img-main">
            <img 
              src={data.images.main.src} 
              alt={data.images.main.alt} 
              loading="lazy"
            />
          </div>
          <div class="img-secondary">
            <img 
              src={data.images.secondary.src} 
              alt={data.images.secondary.alt} 
              loading="lazy"
            />
          </div>
          <div class="img-accent">
            <span class="accent-num">{data.images.accent.num}</span>
            <span class="accent-label" set:html={data.images.accent.label}></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    background: var(--bg-body);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: start;
  }

  .about-text {
    color: var(--ink-body);
    line-height: 1.9;
    margin-bottom: 1.25rem;
    font-size: 0.97rem;
  }

  .about-text strong {
    color: var(--ink);
    font-weight: 600;
  }

  .about-pillars {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .pillar {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .pillar-icon {
    width: 44px;
    height: 44px;
    background: var(--saffron-pale);
    border: 1px solid var(--border);
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--saffron);
    margin-top: 2px;
  }

  .pillar h4 {
    font-family: 'Playfair Display', serif;
    font-size: 1rem;
    color: var(--ink);
    margin-bottom: 0.25rem;
  }

  .pillar p {
    font-size: 0.85rem;
    color: var(--ink-muted);
    line-height: 1.6;
  }

  /* Image stack */
  .about-visual {
    position: sticky;
    top: 6rem;
  }

  .image-stack {
    position: relative;
    height: 560px;
  }

  .img-main {
    position: absolute;
    top: 0;
    left: 0;
    width: 80%;
    height: 65%;
    border-radius: 6px;
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--border);
  }

  .img-main img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .img-main:hover img { transform: scale(1.04); }

  .img-secondary {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 65%;
    height: 52%;
    border-radius: 6px;
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--border);
  }

  .img-secondary img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transition: transform 0.6s ease;
  }

  .img-secondary:hover img { transform: scale(1.04); }

  .img-accent {
    position: absolute;
    bottom: 52%;
    left: 78%;
    transform: translate(-50%, 50%);
    width: 90px;
    height: 90px;
    background: var(--saffron);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    text-align: center;
    padding: 0.5rem;
    z-index: 10;
    border: 3px solid var(--bg-body);
    box-shadow: var(--shadow-md);
  }

  .accent-num {
    font-family: 'Playfair Display', serif;
    font-size: 1.4rem;
    font-weight: 700;
    color: #FFFFFF;
    line-height: 1;
  }

  .accent-label {
    font-size: 0.55rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.4;
  }

  @media (max-width: 900px) {
    .about-grid { grid-template-columns: 1fr; gap: 3rem; }
    .about-visual { position: static; order: -1; }
    .image-stack { height: 380px; }
  }
  @media (max-width: 480px) { .image-stack { height: 300px; } }
</style>
