---
import data from '../../content/home/rajrangam.json';
---

<section class="rajrangam section" id="rajrangam">
  <div class="rr-bg">
    <img 
      src={data.bgImage} 
      alt={data.bgAlt} 
      class="rr-bg-img"
    />
    <div class="rr-overlay"></div>
  </div>

  <div class="container">
    <div class="rr-content">
      <div class="rr-header animate-in">
        <span class="section-label">{data.label}</span>
        <h2 class="rr-title">
          <span class="hindi-text">{data.titleHindi}</span>
          <span class="rr-english">{data.titleEnglish}</span>
        </h2>
        <p class="rr-tagline">{data.tagline}</p>
        <div class="gold-divider"></div>
        <p class="rr-description" set:html={data.description}></p>
      </div>

      <div class="rr-features animate-in">
        {data.features.map(feature => (
          <div class="rr-feature">
            <div class="feature-icon" set:html={feature.iconHtml}></div>
            <div>
              <h4>{feature.title}</h4>
              <p>{feature.description}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- Image grid -->
      <div class="rr-gallery animate-in">
        {data.gallery.map((item, index) => (
          <div class={`rr-img rr-img-${index + 1}`}>
            <img src={item.img} alt={item.alt} loading="lazy" />
            <div class="rr-img-label">{item.label}</div>
          </div>
        ))}
      </div>

      <!-- Editions timeline -->
      <div class="rr-timeline animate-in">
        <h3 class="timeline-title">{data.timeline.title}</h3>
        <div class="timeline-track">
          {Array.from({length: data.timeline.editions}, (_, i) => i + 1).map(n => (
            <div class={`timeline-node ${n === data.timeline.editions ? 'active' : ''}`}>
              <div class="node-dot"></div>
              <span class="node-label">{n}{n === 1 ? 'st' : n === 2 ? 'nd' : n === 3 ? 'rd' : 'th'}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .rajrangam {
    position: relative;
    overflow: hidden;
  }

  .rr-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .rr-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    filter: brightness(0.18) saturate(0.5);
  }

  .rr-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(13,13,13,0.6) 0%, rgba(13,13,13,0.4) 50%, rgba(13,13,13,0.8) 100%);
  }

  .rr-content {
    position: relative;
    z-index: 1;
  }

  .rr-header {
    max-width: 680px;
    margin-bottom: 3rem;
  }

  .rr-title {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .hindi-text {
    font-family: 'Tiro Devanagari Hindi', 'Playfair Display', serif;
    font-size: clamp(3rem, 7vw, 5rem);
    color: var(--gold);
    line-height: 1.1;
  }

  .rr-english {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: rgba(250, 246, 239, 0.5);
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0.05em;
  }

  .rr-tagline {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--crimson-light);
    margin-top: 0.25rem;
    margin-bottom: 1rem;
  }

  .rr-description {
    font-size: 1rem;
    color: rgba(255, 248, 240, 0.75);
    line-height: 1.9;
  }

  /* Features */
  .rr-features {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-bottom: 3rem;
    max-width: 720px;
  }

  .rr-feature {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .feature-icon {
    width: 42px;
    height: 42px;
    background: rgba(232, 114, 12, 0.18);
    border: 1px solid rgba(232, 114, 12, 0.3);
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--saffron-light);
    flex-shrink: 0;
  }

  .rr-feature h4 {
    font-size: 0.95rem;
    color: #FFFDF7;
    margin-bottom: 0.25rem;
    font-weight: 600;
  }

  .rr-feature p {
    font-size: 0.85rem;
    color: rgba(255, 248, 240, 0.6);
    line-height: 1.6;
  }

  /* Gallery */
  .rr-gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 3rem;
  }

  .rr-img {
    border-radius: 4px;
    overflow: hidden;
    position: relative;
    aspect-ratio: 4/3;
    border: 1px solid var(--border-subtle);
  }

  .rr-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .rr-img:hover img {
    transform: scale(1.05);
  }

  .rr-img-label {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 0.75rem 1rem;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--ivory);
    background: linear-gradient(to top, rgba(10,10,10,0.85), transparent);
  }

  /* Timeline */
  .rr-timeline {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 248, 240, 0.12);
    border-radius: 6px;
    padding: 2rem;
  }

  .timeline-title {
    font-size: 1rem;
    color: #FFFDF7;
    margin-bottom: 1.5rem;
    font-weight: 600;
  }

  .timeline-track {
    display: flex;
    align-items: center;
    gap: 0;
    position: relative;
  }

  .timeline-track::before {
    content: '';
    position: absolute;
    top: 12px;
    left: 12px;
    right: 12px;
    height: 1px;
    background: rgba(255, 248, 240, 0.15);
    z-index: 0;
  }

  .timeline-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    flex: 1;
    position: relative;
    z-index: 1;
  }

  .node-dot {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    border: 2px solid rgba(255, 248, 240, 0.2);
    transition: var(--transition);
  }

  .timeline-node.active .node-dot {
    background: var(--saffron);
    border-color: var(--saffron);
    box-shadow: 0 0 16px rgba(232, 114, 12, 0.5);
  }

  .node-label {
    font-size: 0.75rem;
    color: rgba(255, 248, 240, 0.5);
  }

  .timeline-node.active .node-label {
    color: var(--gold);
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .rr-features { grid-template-columns: 1fr; }
    .rr-gallery { grid-template-columns: 1fr; }
  }
</style>
