---
import data from '../../content/home/mission.json';
---

<section class="mission section" id="mission">
  <div class="container">
    <div class="mission-header animate-in">
      <span class="section-label">{data.header.label}</span>
      <h2 class="section-title" set:html={data.header.title}></h2>
      <div class="gold-divider"></div>
      <p class="section-subtitle">
        {data.header.subtitle}
      </p>
    </div>

    <div class="mission-cards">
      {data.cards.map((card, index) => (
        <div class="mission-card animate-in" data-delay={index}>
          <div class="card-number">{card.number}</div>
          <div class="card-icon" set:html={card.iconHtml}></div>
          <h3>{card.title}</h3>
          <p set:html={card.description}></p>
          <div class="card-tag">{card.tag}</div>
        </div>
      ))}
    </div>

    <div class="impact-bar animate-in">
      {data.impact.map((item, index) => (
        <>
          <div class="impact-item">
            <span class="impact-num">{item.number}</span>
            <span class="impact-label">{item.label}</span>
          </div>
          {index < data.impact.length - 1 && <div class="impact-sep"></div>}
        </>
      ))}
    </div>
  </div>
</section>

<style>
  .mission {
    background: var(--bg-alt);
    position: relative;
  }

  .mission::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--saffron), transparent);
    opacity: 0.25;
  }

  .mission-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .mission-header .gold-divider {
    margin: 1.5rem auto;
    background: linear-gradient(90deg, transparent, var(--saffron), transparent);
    width: 80px;
  }

  .mission-header .section-subtitle {
    margin: 0 auto;
    text-align: center;
  }

  .mission-cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    margin-bottom: 3.5rem;
  }

  .mission-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 2rem;
    position: relative;
    overflow: hidden;
    transition: var(--transition);
    box-shadow: var(--shadow-sm);
  }

  .mission-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--saffron), var(--saffron-pale));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s ease;
    border-radius: 8px 8px 0 0;
  }

  .mission-card:hover::before { transform: scaleX(1); }

  .mission-card:hover {
    border-color: var(--border-strong);
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .card-number {
    font-family: 'Playfair Display', serif;
    font-size: 4rem;
    font-weight: 700;
    color: rgba(232, 114, 12, 0.18);
    position: absolute;
    top: 1rem; right: 1.5rem;
    line-height: 1;
    user-select: none;
    letter-spacing: -0.02em;
  }

  .card-icon {
    width: 50px;
    height: 50px;
    background: var(--saffron-pale);
    border: 1px solid var(--border);
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--saffron);
    margin-bottom: 1.25rem;
  }

  .mission-card h3 {
    font-size: 1.1rem;
    color: var(--ink);
    margin-bottom: 0.75rem;
  }

  .mission-card p {
    font-size: 0.9rem;
    color: var(--ink-body);
    line-height: 1.8;
    margin-bottom: 1.25rem;
  }

  .mission-card p em {
    color: var(--saffron);
    font-style: normal;
    font-weight: 600;
  }

  .card-tag {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--saffron);
    background: var(--saffron-pale);
    border: 1px solid var(--border);
    padding: 0.3rem 0.8rem;
    border-radius: 2px;
  }

  /* Impact bar */
  .impact-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: linear-gradient(135deg, var(--saffron-pale), var(--bg-warm));
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 2.5rem;
    flex-wrap: wrap;
    gap: 2rem;
  }

  .impact-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    text-align: center;
    flex: 1;
    min-width: 120px;
  }

  .impact-num {
    font-family: 'Playfair Display', serif;
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--saffron);
  }

  .impact-label {
    font-size: 0.78rem;
    letter-spacing: 0.05em;
    color: var(--ink-muted);
    text-align: center;
    line-height: 1.5;
  }

  .impact-sep {
    width: 1px;
    height: 50px;
    background: var(--border);
  }

  @media (max-width: 768px) {
    .mission-cards { grid-template-columns: 1fr; }
    .impact-bar { gap: 1.5rem; }
    .impact-sep { display: none; }
  }
</style>
